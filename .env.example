# KDM ERPNext — environment variable template
# Copy this file to .env and fill in all values before running docker-compose up

# ── Authentik OIDC (provided by your KDM's Authentik admin) ──────────────────
# The base URL of the Authentik instance running on this KDM.
AUTHENTIK_URL=https://auth.yourdomain.local

# Client ID and secret from the Authentik OAuth2 provider application.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Slug of the Authentik application (matches the URL slug in Authentik).
# Default is "erpnext" — only change if you named it differently in Authentik.
OIDC_APP_SLUG=erpnext

# ── ERPNext site ──────────────────────────────────────────────────────────────
# The Frappe site name — used internally by bench.  For a single-site setup
# the default is fine.  Use your public hostname if you configure host_name.
FRAPPE_SITE_NAME=erpnext.localhost

# Port on the KDM host where ERPNext will be reachable.
ERPNEXT_PORT=8080

# ── Credentials (set strong values before first boot) ────────────────────────
# MariaDB root password — used to create the site database on first run.
MYSQL_ROOT_PASSWORD=change-me

# ERPNext Administrator account password.
# After first login via Authentik, administrators typically disable this account.
FRAPPE_ADMIN_PASSWORD=change-me

# ── Docker image (set by the MKDM deployment pipeline) ───────────────────────
# Do not edit manually — MKDM fills this in when deploying to a KDM.
ERPNEXT_IMAGE=
